#!/bin/zsh

set -e

state_file="${CODEX_TRANSCRIBE_STATE_FILE:-/Users/williamxu/.codex/codex-transcribe-state}"
script_dir="${0:A:h}"
default_state="$script_dir/transcribe-state"

mkdir -p "${state_file:h}"
if [[ ! -r "$state_file" ]]; then
  cp "$default_state" "$state_file"
fi

source "$state_file"
: ${CODEX_TRANSCRIBE_PROVIDER:=openai}
: ${CODEX_TRANSCRIBE_LANGUAGE:=en}
: ${CODEX_TRANSCRIBE_API_KEY:=}
: ${CODEX_TRANSCRIBE_DURATION:=4}

write_state() {
  typeset -p \
    CODEX_TRANSCRIBE_PROVIDER \
    CODEX_TRANSCRIBE_LANGUAGE \
    CODEX_TRANSCRIBE_API_KEY \
    CODEX_TRANSCRIBE_DURATION > "$state_file"
}

usage() {
  print "Usage: transcribe-command [status|capture [seconds]|record-wav [seconds] [path]|record-wav-live <path> [level-json]|transcribe-file <path>|set-provider <provider>|set-key <api_key>|set-language <language>|set-duration <seconds>|help]"
}

masked_api_key() {
  if [[ -z "$CODEX_TRANSCRIBE_API_KEY" ]]; then
    print "unset"
  elif (( ${#CODEX_TRANSCRIBE_API_KEY} <= 8 )); then
    print "********"
  else
    print "${CODEX_TRANSCRIBE_API_KEY[1,4]}...${CODEX_TRANSCRIBE_API_KEY[-4,-1]}"
  fi
}

json_text() {
  python3 -c '
import json, sys
data = json.load(sys.stdin)
if "error" in data:
    err = data["error"]
    print(err.get("message", err) if isinstance(err, dict) else err, file=sys.stderr)
    sys.exit(1)
text = data.get("text")
if text is None:
    parts = data.get("candidates", [{}])[0].get("content", {}).get("parts", [])
    text = "".join(part.get("text", "") for part in parts)
print((text or "").strip())
'
}

record_wav() {
  local seconds="${1:-$CODEX_TRANSCRIBE_DURATION}"
  local out="${2:-${TMPDIR:-/tmp}/codex-transcribe-${EPOCHSECONDS}.wav}"
  local input="${CODEX_TRANSCRIBE_FFMPEG_INPUT:-:default}"

  if ! command -v ffmpeg >/dev/null 2>&1; then
    print "ffmpeg is required to record audio" >&2
    exit 1
  fi

  ffmpeg -hide_banner -loglevel error -y \
    -f avfoundation -i "$input" \
    -t "$seconds" -ac 1 -ar 16000 "$out"
  print "$out"
}

record_wav_live() {
  local out="${1:-}"
  local level_file="${2:-}"
  local input="${CODEX_TRANSCRIBE_FFMPEG_INPUT:-:default}"
  [[ -n "$out" ]] || { print "output wav path required" >&2; usage; exit 1; }

  if ! command -v ffmpeg >/dev/null 2>&1; then
    print "ffmpeg is required to record audio" >&2
    exit 1
  fi

  local args=(--output "$out" --input "$input")
  if [[ -n "$level_file" ]]; then
    args+=(--level-file "$level_file")
  fi
  exec python3 "$script_dir/record-wav-live.py" "${args[@]}"
}

transcribe_openai() {
  local wav="$1"
  local model="${CODEX_TRANSCRIBE_OPENAI_MODEL:-gpt-4o-mini-transcribe}"
  [[ -n "$CODEX_TRANSCRIBE_API_KEY" ]] || { print "transcribe API key is not set" >&2; exit 1; }

  local args=(
    -sS "https://api.openai.com/v1/audio/transcriptions"
    -H "Authorization: Bearer $CODEX_TRANSCRIBE_API_KEY"
    -F "file=@$wav"
    -F "model=$model"
  )
  if [[ "$CODEX_TRANSCRIBE_LANGUAGE" != "auto" && -n "$CODEX_TRANSCRIBE_LANGUAGE" ]]; then
    args+=(-F "language=$CODEX_TRANSCRIBE_LANGUAGE")
  fi
  curl "${args[@]}" | json_text
}

transcribe_gemini() {
  local wav="$1"
  local model="${CODEX_TRANSCRIBE_GEMINI_MODEL:-gemini-3.5-flash}"
  [[ -n "$CODEX_TRANSCRIBE_API_KEY" ]] || { print "transcribe API key is not set" >&2; exit 1; }

  local b64
  b64="$(base64 < "$wav" | tr -d '\n')"
  local payload
  payload="$(python3 - "$b64" "$CODEX_TRANSCRIBE_LANGUAGE" <<'PY'
import json, sys
b64, language = sys.argv[1], sys.argv[2]
prompt = "Transcribe this audio. Return only the spoken text."
if language and language != "auto":
    prompt += f" Language hint: {language}."
print(json.dumps({
    "contents": [{
        "parts": [
            {"text": prompt},
            {"inline_data": {"mime_type": "audio/wav", "data": b64}},
        ]
    }]
}))
PY
)"
  curl -sS "https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent" \
    -H "x-goog-api-key: $CODEX_TRANSCRIBE_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$payload" | json_text
}

transcribe_groq() {
  local wav="$1"
  local model="${CODEX_TRANSCRIBE_GROQ_MODEL:-whisper-large-v3-turbo}"
  [[ -n "$CODEX_TRANSCRIBE_API_KEY" ]] || { print "transcribe API key is not set" >&2; exit 1; }

  local args=(
    -sS "https://api.groq.com/openai/v1/audio/transcriptions"
    -H "Authorization: Bearer $CODEX_TRANSCRIBE_API_KEY"
    -F "file=@$wav"
    -F "model=$model"
    -F "response_format=json"
  )
  if [[ "$CODEX_TRANSCRIBE_LANGUAGE" != "auto" && -n "$CODEX_TRANSCRIBE_LANGUAGE" ]]; then
    args+=(-F "language=$CODEX_TRANSCRIBE_LANGUAGE")
  fi
  curl "${args[@]}" | json_text
}

transcribe_file() {
  local wav="$1"
  [[ -r "$wav" ]] || { print "audio file not found: $wav" >&2; exit 1; }
  case "$CODEX_TRANSCRIBE_PROVIDER" in
    openai) transcribe_openai "$wav" ;;
    gemini) transcribe_gemini "$wav" ;;
    groq) transcribe_groq "$wav" ;;
    *) print "unsupported provider: $CODEX_TRANSCRIBE_PROVIDER" >&2; exit 1 ;;
  esac
}

cmd="${1:-status}"
if (( $# > 0 )); then
  shift
fi

case "$cmd" in
  status)
    print "provider=${CODEX_TRANSCRIBE_PROVIDER}"
    print "language=${CODEX_TRANSCRIBE_LANGUAGE}"
    print "duration=${CODEX_TRANSCRIBE_DURATION}"
    if [[ -n "$CODEX_TRANSCRIBE_API_KEY" ]]; then
      print "api_key=set"
    else
      print "api_key=unset"
    fi
    print "api_key_mask=$(masked_api_key)"
    ;;
  capture)
    seconds="${1:-$CODEX_TRANSCRIBE_DURATION}"
    wav="$(record_wav "$seconds")"
    transcribe_file "$wav"
    ;;
  record-wav)
    record_wav "${1:-$CODEX_TRANSCRIBE_DURATION}" "${2:-}"
    ;;
  record-wav-live)
    record_wav_live "${1:-}" "${2:-}"
    ;;
  transcribe-file)
    wav="${1:-}"
    [[ -n "$wav" ]] || { print "audio file required" >&2; usage; exit 1; }
    transcribe_file "$wav"
    ;;
  set-provider)
    CODEX_TRANSCRIBE_PROVIDER="${1:-}"
    [[ -n "$CODEX_TRANSCRIBE_PROVIDER" ]] || { print "provider required" >&2; usage; exit 1; }
    [[ "$CODEX_TRANSCRIBE_PROVIDER" == (openai|gemini|groq) ]] || { print "unsupported provider: $CODEX_TRANSCRIBE_PROVIDER" >&2; exit 1; }
    write_state
    print "transcribe provider set to ${CODEX_TRANSCRIBE_PROVIDER}"
    ;;
  set-key)
    CODEX_TRANSCRIBE_API_KEY="${*:-}"
    [[ -n "$CODEX_TRANSCRIBE_API_KEY" ]] || { print "api key required" >&2; usage; exit 1; }
    write_state
    print "transcribe API key updated"
    ;;
  set-language)
    CODEX_TRANSCRIBE_LANGUAGE="${1:-}"
    [[ -n "$CODEX_TRANSCRIBE_LANGUAGE" ]] || { print "language required" >&2; usage; exit 1; }
    write_state
    print "transcribe language set to ${CODEX_TRANSCRIBE_LANGUAGE}"
    ;;
  set-duration)
    CODEX_TRANSCRIBE_DURATION="${1:-}"
    [[ "$CODEX_TRANSCRIBE_DURATION" == <-> ]] || { print "duration must be seconds" >&2; exit 1; }
    write_state
    print "transcribe duration set to ${CODEX_TRANSCRIBE_DURATION}"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
